{
  "name": "wrought-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ci": "bun install --frozen-lockfile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "deploy": "bun src/deployment/deploy.ts",
    "test:deployment": "bun test src/deployment",
    "test:scenarios": "bun test src/scenario/architecture-tests",
    "verify:scenarios": "bun src/scenario/verify.ts",
    "e2e": "tsx src/e2e.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
